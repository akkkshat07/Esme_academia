    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Email/Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('auth_token', JSON.stringify(jsonData.user));",
                  "    console.log('✅ Login Successful:', jsonData.user.name);",
                  "} else {",
                  "    console.log('❌ Login Failed:', pm.response.code, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"neel.sharma@esmeconsumer.in\",\n  \"password\": \"Ns123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "login"]
            }
          }
        },
