# Server
PORT=3002

# Google Sheets (reuse SAME service account as your current backend)
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=12345678901234567890
SHEET_ID=your-google-sheet-id
PRIVATE_KEY_PATH=private_key.pem

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-admin.json
FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com

# Email for nudges (SMTP)
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USER=no-reply@yourcompany.com
SMTP_PASS=yourpassword
